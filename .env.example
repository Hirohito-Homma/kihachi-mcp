# KIHACHI MUSIC AI 環境変数の例。
#
# Live 自動操作は外部 API キーを必要としません。Google Lyria は廃止済みです。
# 秘密情報はループバック用のセッショントークン1つだけで、起動ごとに自動生成され、
# 所有者のみ読めるハンドシェイクファイル経由で Max デバイスへ渡されます。
# トークンをこのファイルや Git へ書かないでください。

# Memory をプロセス再起動後も保持する場合の保存先。未設定ならプロセス内のみ。
KIHACHI_MEMORY_PATH=

# 承認記録と使用済み idempotency key の保存先。未設定ならプロセス内のみ。
# 未設定の場合、サーバー再起動で二重実行の防止記録が消えます。
KIHACHI_LIVE_APPROVAL_PATH=

# 承認トークンの書き出し先。未設定ならプラットフォーム既定の state ディレクトリ。
# 人間がこのファイルを開いてトークンを読み、execute_live_request へ渡します。
KIHACHI_LIVE_APPROVAL_TOKEN_PATH=

# ループバック Bridge のポート。127.0.0.1 のみ。外部へ bind しません。
# 変更した場合は Max パッチの [udpreceive] と [udpsend] も合わせてください。
KIHACHI_LIVE_BRIDGE_PORT=17771
KIHACHI_LIVE_REPLY_PORT=17772

# ハンドシェイクファイルを置くディレクトリの上書き。通常は不要。
# 既定: macOS ~/Library/Application Support/KIHACHI
#       Windows %LOCALAPPDATA%\KIHACHI
KIHACHI_LIVE_STATE_DIR=

# --- MCP Gateway（Manus など外部クライアント）---
# 既定の `python -m kihachi_mcp.server` は stdio のままです。
# HTTP は `kihachi serve --transport streamable-http`。
# 待受は 127.0.0.1 のみ。0.0.0.0 は拒否します。
# 8765 は制作画面、9877 は AbletonGPT Remote Script です。Gateway は使いません。
# トークンはここに書かず、起動したシェルの環境変数だけに置いてください。

KIHACHI_MCP_TRANSPORT=stdio
KIHACHI_MCP_HOST=127.0.0.1
KIHACHI_MCP_PORT=8787
KIHACHI_MCP_PATH=/mcp
KIHACHI_MCP_AUTH_ENABLED=true
KIHACHI_MCP_API_TOKEN=
KIHACHI_MCP_JSON_RESPONSE=true
KIHACHI_MCP_STATELESS=true
KIHACHI_MCP_MAX_BODY_BYTES=1048576
KIHACHI_MCP_ABLETON_TIMEOUT_SECONDS=5
# トンネルが公開ホスト名を Host ヘッダに残すときだけ、そのホスト名を足します。
KIHACHI_MCP_ALLOWED_HOSTS=
KIHACHI_MCP_ALLOWED_ORIGINS=

# AbletonGPT Remote Script。127.0.0.1 以外は拒否します。
# セッショントークンは AbletonGPT の config.json から読み、このファイルには書きません。
ABLETONGPT_HOST=127.0.0.1
ABLETONGPT_PORT=9877
# 既存の名前。ABLETONGPT_PORT が無いときだけ使います。
KIHACHI_ABLETONGPT_PORT=9877
